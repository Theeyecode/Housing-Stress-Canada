        "# Optional: quick alignment check with true labels\n",
        "from sklearn.metrics import confusion_matrix\n",
        "print(\"\\nConfusion matrix at threshold 0.30:\")\n",
        "print(confusion_matrix(y_test, df_test[\"Predicted_Housing_Stress\"]))\n"
