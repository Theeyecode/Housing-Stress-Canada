        "import numpy as np\n",
        "import pandas as pd\n",
        "from sklearn.metrics import recall_score, precision_score\n",
        "\n",
        "thresholds = np.arange(0.1, 0.91, 0.05)\n",
        "\n",
        "rows = []\n",
        "for t in thresholds:\n",
        "    y_pred_t = (y_prob >= t).astype(int)\n",
        "\n",
        "    rows.append({\n",
        "        \"threshold\": round(t, 2),\n",
        "        \"recall\": recall_score(y_test, y_pred_t),        # recall for stressed (1)\n",
        "        \"precision\": precision_score(y_test, y_pred_t),  # precision for stressed (1)\n",
        "        \"flagged_rate\": y_pred_t.mean()                  # % households flagged as stressed\n",
        "    })\n",
        "\n",
        "threshold_table = pd.DataFrame(rows)\n",
        "threshold_table\n"
      ]
    },
