    {
      "cell_type": "markdown",
      "source": [
        "# ============================================================\n",
        "# Method 1 (General Analytics): Risk-Based Segmentation (Clustering)\n",
        "# Goal: turn household-level risk scores into interpretable segments\n",
        "# ============================================================"
      ],
      "metadata": {
        "id": "TMaz0AIVNw6M"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "from sklearn.compose import ColumnTransformer\n",
        "from sklearn.pipeline import Pipeline\n",
        "from sklearn.preprocessing import OneHotEncoder, StandardScaler\n",
        "from sklearn.impute import SimpleImputer\n",
        "from sklearn.cluster import KMeans\n",
        "from sklearn.metrics import silhouette_score\n",
        "\n",
        "# ---- Load df_scored if needed (uses your uploaded df_scored.csv) ----\n",
        "if \"df_scored\" not in globals():\n",
        "    df_scored = pd.read_csv(\"/mnt/artifacts/df_scored.csv\")\n",
        "\n",
        "# ---- Guardrails: remove confusing/leaky label if present ----\n",
        "if \"PCHN_Clean\" in df_scored.columns:\n",
        "    df_scored = df_scored.drop(columns=[\"PCHN_Clean\"])\n",
        "\n",
        "# ---- Choose interpretable segmentation inputs (only those that exist) ----\n",
        "candidate_cols = [\n",
        "    \"prob_housing_stress\",\n",
        "    \"PDCT_05_Clean\",         # tenure\n",
        "    \"PHHTTINC_Clean\",        # household income\n",
        "    \"Income_Quintile\",\n",
        "    \"PHHSIZE_Clean\",         # household size\n",
        "    \"PHTYPE\",                # household type\n",
        "    \"PMINOR\",                # children presence\n",
        "    \"Province_Name\", \"Region_Name\"\n",
        "]\n",
        "seg_cols = [c for c in candidate_cols if c in df_scored.columns]\n",
        "\n",
        "if \"prob_housing_stress\" not in seg_cols:\n",
        "    raise ValueError(\"prob_housing_stress not found. df_scored must contain the model risk score.\")\n",
        "\n",
        "X = df_scored[seg_cols].copy()\n",
        "\n",
        "num_cols = [c for c in X.columns if pd.api.types.is_numeric_dtype(X[c])]\n",
        "cat_cols = [c for c in X.columns if c not in num_cols]\n",
        "\n",
        "preprocess = ColumnTransformer(\n",
        "    transformers=[\n",
        "        (\"num\", Pipeline([\n",
        "            (\"imputer\", SimpleImputer(strategy=\"median\")),\n",
        "            (\"scaler\", StandardScaler()),\n",
        "        ]), num_cols),\n",
        "        (\"cat\", Pipeline([\n",
        "            (\"imputer\", SimpleImputer(strategy=\"most_frequent\")),\n",
        "            (\"ohe\", OneHotEncoder(handle_unknown=\"ignore\")),\n",
        "        ]), cat_cols),\n",
        "    ],\n",
        "    remainder=\"drop\"\n",
        ")\n",
        "\n",
        "# ---- Pick K with silhouette (visual) ----\n",
        "k_candidates = [2, 3, 4, 5, 6]\n",
        "sil_scores = []\n",
        "\n",
        "Z_cached = {}\n",
        "for k in k_candidates:\n",
        "    pipe = Pipeline([\n",
        "        (\"prep\", preprocess),\n",
        "        (\"km\", KMeans(n_clusters=k, random_state=42, n_init=10)),\n",
        "    ])\n",
        "    labels = pipe.fit_predict(X)\n",
        "    sil = silhouette_score(pipe.named_steps[\"prep\"].transform(X), labels)\n",
        "    sil_scores.append(sil)\n",
        "    Z_cached[k] = (pipe, labels)\n",
        "\n",
        "plt.figure()\n",
        "plt.plot(k_candidates, sil_scores, marker=\"o\")\n",
        "plt.xticks(k_candidates)\n",
        "plt.xlabel(\"Number of clusters (K)\")\n",
        "plt.ylabel(\"Silhouette score\")\n",
        "plt.title(\"Choose K for Risk Segmentation (Higher is better)\")\n",
        "plt.show()\n",
        "\n",
        "best_k = k_candidates[int(np.argmax(sil_scores))]\n",
        "seg_model, labels = Z_cached[best_k]\n",
        "df_scored[\"Risk_Segment\"] = labels\n",
        "\n",
        "print(f\"Selected K = {best_k} (best silhouette = {max(sil_scores):.3f})\")\n",
        "\n",
        "# ---- Visual 1: segment sizes ----\n",
        "seg_counts = df_scored[\"Risk_Segment\"].value_counts().sort_index()\n",
        "\n",
        "plt.figure()\n",
        "plt.bar(seg_counts.index.astype(str), seg_counts.values)\n",
        "plt.xlabel(\"Risk Segment\")\n",
        "plt.ylabel(\"Households\")\n",
        "plt.title(\"Segment Size (Count of Households)\")\n",
        "plt.show()\n",
        "\n",
        "# ---- Visual 2: risk score distribution by segment (boxplot) ----\n",
        "segments = [df_scored.loc[df_scored[\"Risk_Segment\"] == s, \"prob_housing_stress\"].dropna().values\n",
        "            for s in sorted(df_scored[\"Risk_Segment\"].unique())]\n",
        "\n",
        "plt.figure()\n",
        "plt.boxplot(segments, labels=[str(s) for s in sorted(df_scored[\"Risk_Segment\"].unique())], showfliers=False)\n",
        "plt.xlabel(\"Risk Segment\")\n",
        "plt.ylabel(\"prob_housing_stress\")\n",
        "plt.title(\"Risk Score Distribution by Segment\")\n",
        "plt.show()\n",
        "\n",
        "# ---- Visual 3 (optional): tenure mix by segment (stacked bar) ----\n",
        "if \"PDCT_05_Clean\" in df_scored.columns:\n",
        "    ctab = pd.crosstab(df_scored[\"Risk_Segment\"], df_scored[\"PDCT_05_Clean\"], normalize=\"index\").sort_index()\n",
        "\n",
        "    plt.figure()\n",
        "    bottom = np.zeros(len(ctab))\n",
        "    x = np.arange(len(ctab.index))\n",
        "    for col in ctab.columns:\n",
        "        vals = ctab[col].values\n",
        "        plt.bar(x, vals, bottom=bottom, label=str(col))\n",
        "        bottom += vals\n",
        "\n",
        "    plt.xticks(x, [str(i) for i in ctab.index])\n",
        "    plt.xlabel(\"Risk Segment\")\n",
        "    plt.ylabel(\"Share within segment\")\n",
        "    plt.title(\"Tenure Composition by Segment (Share)\")\n",
        "    plt.legend(title=\"PDCT_05_Clean\", bbox_to_anchor=(1.02, 1), loc=\"upper left\")\n",
        "    plt.tight_layout()\n",
        "    plt.show()"
      ],
