        "import joblib\n",
        "import os\n",
        "\n",
        "\n",
        "# ---- Score FULL dataset (not just test) ----\n",
        "y_prob_full = baseline_model.predict_proba(X)[:, 1]\n",
        "\n",
        "df_scored = df_analytic.copy()\n",
        "\n",
        "df_scored[\"prob_housing_stress\"] = y_prob_full\n",
        "df_scored[\"Predicted_Housing_Stress\"] = (y_prob_full >= 0.30).astype(int)\n",
        "\n",
        "# Optional: risk bands\n",
        "df_scored[\"Risk_Band\"] = pd.cut(\n",
        "    df_scored[\"prob_housing_stress\"],\n",
        "    bins=[0, 0.15, 0.30, 1.0],\n",
        "    labels=[\"Low\", \"Medium\", \"High\"],\n",
        "    include_lowest=True\n",
        ")\n",
        "\n",
        "# ---- Save clean artifact ----\n",
